# Ubuntu 24.04 LTS preseed file for cloud-init first-boot
d-i debian-installer/splash boolean true
d-i debian-installer/splash/none boolean true

d-i debian-installer/locale string en_US
d-i debian-installer/country string US
d-i debian-installer/iso3166code string US

d-i keyboard-configuration/xkb-keymap select us
d-i console-setup/askpass boolean false

d-i netcfg/choose_interface select auto

d-i netcfg/get_hostname string iPXE-Server
d-i netcfg/get_domain string local

d-i netcfg/dhcp_timeout string 60

d-i netcfg/hostname string iPXE-Server

d-i passwd/root-password password insecure
d-i passwd/root-password-again password insecure
d-i passwd/user-fullname string Admin User
d-i passwd/username string admin
d-i passwd/user-password password insecure
d-i passwd/user-password-again password insecure
d-i passwd/user-ssh-login boolean true
d-i passwd/lock-passwords boolean false

d-i apt-setup/preserve-conffiles boolean true
d-i apt-setup/services-select multiselect http

d-i netcfg/disable_autoconfigure_boolean boolean false
d-i ubuntu-installer/environ-remote-access string yes

d-i clock-setup/ntp boolean true
d-i time/zone string UTC
d-i clock-setup/ntp/ntp-server string pool.ntp.org

d-i debian-installer/continue boolean true
d-i debian-installer/splash/manual_image_file string /boot/splash.png

d-i preseed/timeout string 0
d-i auto-install/enable boolean true