#!ipxe

set base-url http://localhost:8080/ubuntu/current
set mtu 9000
set timeout 10

echo ========================================
echo iPXE Boot for Ubuntu 24.04 LTS Diskless
echo ========================================

# Set MTU for jumbo frames
set mtu ${mtu}

# Detect network interface
chain http://${base-url}/boot.ipxe

# Alternative: manual network setup
echo Attempting network boot...
dhcp

# Configure MTU
set net0/mtu ${mtu}

# Boot from HTTP
kernel http://${base-url}/vmlinuz \
    boot=casper \
    ip=dhcp \
    boot=casper \
    noprompt \
    boot=casper \
    file=/cdrom/preseed/ubuntu.seed \
    boot=casper \
    initrd=http://${base-url}/initrd \
    BOOT_IMAGE=/casper/vmlinuz

initrd http://${base-url}/initrd

echo Booting Ubuntu 24.04 LTS...
boot