#!ipxe

set mtu 9000
set http-port 80
set iso-name ubuntu-24.04-custom.iso

echo =================================================
echo Ubuntu 24.04 LTS Server ISO Boot - iPXE over HTTP
echo =================================================

dhcp || goto failed
set net0/mtu ${mtu} || echo Could not set MTU ${mtu} in iPXE

isset ${boot-server} || set boot-server ${next-server}
isset ${boot-url} || set boot-url http://${boot-server}:${http-port}

echo Boot URL: ${boot-url}
echo ISO: ${boot-url}/iso/${iso-name}

kernel ${boot-url}/iso/casper/vmlinuz \
    boot=casper \
    netboot=url \
    url=${boot-url}/iso/${iso-name} \
    ip=dhcp \
    ds=nocloud-net;s=${boot-url}/cloud-init/ \
    ---
initrd ${boot-url}/iso/casper/initrd
boot || goto failed

:failed
echo iPXE boot failed
shell
